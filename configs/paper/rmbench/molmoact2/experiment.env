IMPRINT_BENCHMARK=rmbench
IMPRINT_BACKBONE=molmoact2
IMPRINT_ARCHITECTURE=full_attention
IMPRINT_STAGE1_RUN=rmbench-molmoact2-stage1
IMPRINT_STAGE1_SELECTED_STEP=160000
IMPRINT_STAGE2_RUN=rmbench-molmoact2-stage2

MOLMOACT2_RUN_VARIANT=native
MOLMOACT2_BASE_MODEL=allenai/MolmoAct2
MOLMOACT2_STAGE2_STEPS=100000
MOLMOACT2_ACTION_HORIZON=50
MOLMOACT2_ACTION_DIM=16
MOLMOACT2_NUM_LATENTS=256
MOLMOACT2_MEMORY_DIM=1024
MOLMOACT2_GLOBAL_BATCH_SIZE=4
MOLMOACT2_DEVICE_BATCH_SIZE=1

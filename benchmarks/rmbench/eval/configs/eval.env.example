RMBENCH_ROOT=/path/to/RMBench
IMPRINT_CHECKPOINT=/path/to/stage2/step-100000
DINOV3_MODEL_PATH=/path/to/local/dinov3-model
IMPRINT_ARCHITECTURE=full_attention
IMPRINT_TASK=cover_blocks
IMPRINT_TRIALS=1
IMPRINT_START_SEED=100000
IMPRINT_OUTPUT=outputs/rmbench/cover-smoke
IMPRINT_POLICY_PYTHON=/path/to/imprint/.venv/bin/python
RMBENCH_SIM_PYTHON=/path/to/rmbench/.venv/bin/python
IMPRINT_POLICY_GPU=0
RMBENCH_SIM_GPU=1
